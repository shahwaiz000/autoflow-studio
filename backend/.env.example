# Copy to .env to override defaults. Never commit real secrets.
DATABASE_URL=sqlite:///./autoflow.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# Email alerts (optional). Leave SMTP_HOST empty and alerts are only written to the run log.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
# SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<a Google "app password", not your normal password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# ALERT_ALLOWED_DOMAINS=yourcompany.com
# APP_URL=http://localhost:5173
